pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    tools {
        jdk 'jdk21'
        nodejs 'node24'
    }

    stages {

        stage('Checkout PR') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('app') {
                    sh 'npm ci'
                }
            }
        }

        stage('Unit Testing') {
            steps {
                dir('app') {
                    sh 'npm test -- --coverage'
                }
            }
        }

        stage('SonarCloud SAST') {
            steps {
                script {
                    def scannerHome = tool 'sonar-scanner'

                    dir('app') {
                        withSonarQubeEnv('SonarCloud') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \\
                                -Dsonar.projectKey=Jefferson-ohis1_end-to-end-node-ci-cd-devsecops \\
                                -Dsonar.organization=jefferson-ohis1 \\
                                -Dsonar.sources=. \\
                                -Dsonar.host.url=https://sonarcloud.io \\
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \\
                                -Dsonar.qualitygate.wait=true
                            """
                        }
                    }
                }
            }
        }

        stage('Snyk SCA') {
            steps {
                dir('app') {
                    snykSecurity(
                        snykInstallation: 'Snyk',
                        snykTokenId: 'snyk-token',
                        severity: 'high',
                        failOnIssues: false,
                        failOnError: true,
                        targetFile: 'package.json'
                    )
                }
            }
        }
    }

    post {

        always {
            echo 'PR validation completed.'
        }

        success {
            echo '✅ PR validation PASSED.'
            echo '✅ Unit Testing PASSED.'
            echo '✅ SonarCloud SAST PASSED.'
            echo '✅ Snyk SCA PASSED.'
        }

        failure {
            echo '❌ PR validation FAILED.'
            echo '⚠️ Review the failed stage and console output.'
        }

        unstable {
            echo '⚠️ PR validation completed with an unstable result.'
        }

        aborted {
            echo '⚠️ PR validation was aborted.'
        }
    }
}